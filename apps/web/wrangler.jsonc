{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "margrop-labs",
  "compatibility_date": "2026-07-24",
  "workers_dev": false,
  "routes": [
    {
      "pattern": "lab.margrop.net",
      "custom_domain": true,
    },
  ],
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
  },
  "env": {
    "preview": {
      "name": "margrop-labs-preview",
      "workers_dev": true,
      "routes": [],
    },
  },
}
