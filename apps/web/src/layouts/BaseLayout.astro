---
import "../styles/global.css";
import { buildSeoMetadata } from "../lib/seo";

interface Props {
  title: string;
  description: string;
  socialTitle?: string;
  socialDescription?: string;
  socialImagePath?: string;
  socialImageAlt?: string;
  indexable?: boolean;
  structuredData?: Record<string, unknown> | readonly Record<string, unknown>[];
}

const {
  title,
  description,
  socialTitle,
  socialDescription,
  socialImagePath,
  socialImageAlt,
  indexable,
  structuredData,
} = Astro.props;
const seo = buildSeoMetadata({
  site: Astro.site,
  pathname: Astro.url.pathname,
  title,
  description,
  socialTitle,
  socialDescription,
  socialImagePath,
  socialImageAlt,
  indexable,
});
const structuredDataJson = structuredData
  ? JSON.stringify(structuredData).replaceAll("<", "\\u003c")
  : undefined;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={seo.description} />
    <meta name="robots" content={seo.robots} />
    <meta name="theme-color" content="#08111f" />
    <link rel="canonical" href={seo.canonical} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta property="og:type" content={seo.openGraphType} />
    <meta property="og:site_name" content={seo.siteName} />
    <meta property="og:locale" content="zh_CN" />
    <meta property="og:url" content={seo.canonical} />
    <meta property="og:title" content={seo.socialTitle} />
    <meta property="og:description" content={seo.socialDescription} />
    <meta property="og:image" content={seo.socialImage} />
    <meta property="og:image:secure_url" content={seo.socialImage} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={seo.socialImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={seo.socialTitle} />
    <meta name="twitter:description" content={seo.socialDescription} />
    <meta name="twitter:image" content={seo.socialImage} />
    <meta name="twitter:image:alt" content={seo.socialImageAlt} />
    {
      structuredDataJson && (
        <script
          is:inline
          type="application/ld+json"
          set:html={structuredDataJson}
        />
      )
    }
    <title>{seo.title}</title>
  </head>
  <body>
    <a class="skip-link" href="#main-content">跳到主要内容</a>
    <header class="site-header">
      <a class="brand" href="/" aria-label="Margrop Labs 首页">
        <span class="brand-mark" aria-hidden="true">M</span>
        <span>
          <strong>MARGROP</strong>
          <small>LABS</small>
        </span>
      </a>
      <nav aria-label="主导航">
        <a href="/#labs-heading">实验</a>
        <a href="/#hello-lab">立即体验</a>
        <a href="https://blog.margrop.net/">博客</a>
        <a href="https://github.com/margrop/margrop-labs">源码</a>
      </nav>
    </header>
    <main id="main-content">
      <slot />
    </main>
    <footer class="site-footer">
      <p>确定性内核，AI 增强。敏感原始输入优先在浏览器本地处理。</p>
      <a href="https://blog.margrop.net/">返回魔都水滴</a>
    </footer>
  </body>
</html>
