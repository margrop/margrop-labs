---
import BaseLayout from "../layouts/BaseLayout.astro";
import TokenBudgetPreview from "../components/TokenBudgetPreview";
import {
  type LabAiMode,
  type LabInputPrivacy,
  type LabStatus,
  loadLabManifests,
} from "../lib/lab-manifests";

const strategicLabOrder = new Map([
  ["token-forge", 0],
  ["interview-workbench", 1],
  ["incident-detective", 2],
  ["smart-rma", 3],
]);

const labs = (await loadLabManifests()).sort(
  (left, right) =>
    (strategicLabOrder.get(left.id) ?? Number.MAX_SAFE_INTEGER) -
      (strategicLabOrder.get(right.id) ?? Number.MAX_SAFE_INTEGER) ||
    left.id.localeCompare(right.id),
);

const statusLabels: Record<LabStatus, string> = {
  proposed: "规划中",
  building: "建设中",
  alpha: "Alpha",
  beta: "Beta",
  stable: "稳定版",
};

const privacyLabels: Record<LabInputPrivacy, string> = {
  public: "公开输入",
  "local-first": "本地优先",
  sensitive: "敏感输入",
};

const aiModeLabels: Record<LabAiMode, string> = {
  none: "无需 AI",
  optional: "AI 可选",
  required: "需要 AI",
};

const strategicStatusLabels: Readonly<Record<string, string>> = {
  "token-forge": "Alpha · 主线",
  "interview-workbench": "Alpha · 本地文本",
  "incident-detective": "Alpha · 维护",
  "smart-rma": "Alpha · 可用",
};

const accents = ["cyan", "violet", "amber"] as const;
const description =
  "把 AI Agent、Self-hosting、PVE、NAS 与可观测性文章变成可以立即体验和验证的互动实验。";
const structuredData = [
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    name: "Margrop Labs",
    alternateName: "魔都水滴实验室",
    url: "https://lab.margrop.net/",
    description,
    inLanguage: "zh-CN",
    publisher: {
      "@type": "Person",
      name: "Margrop",
      url: "https://blog.margrop.net/",
    },
  },
  {
    "@context": "https://schema.org",
    "@type": "ItemList",
    name: "Margrop Labs 可体验实验",
    itemListElement: labs
      .filter((lab) => ["alpha", "beta", "stable"].includes(lab.status))
      .map((lab, index) => ({
        "@type": "ListItem",
        position: index + 1,
        name: lab.title,
        url: new URL(lab.route, "https://lab.margrop.net").toString(),
      })),
  },
] as const;
---

<BaseLayout
  title="Margrop Labs｜魔都水滴实验室"
  {description}
  socialTitle="Margrop Labs｜把技术文章变成可验证实验"
  socialImagePath="/social/margrop-labs.png"
  socialImageAlt="Margrop Labs：把技术文章变成可以亲手验证的实验"
  {structuredData}
>
  <section class="hero">
    <div class="hero-grid" aria-hidden="true"></div>
    <div class="hero-content">
      <p class="eyebrow">AI INFRASTRUCTURE PLAYGROUND</p>
      <h1>把技术文章，变成可以<br /><em>亲手验证</em>的实验。</h1>
      <p class="hero-summary">
        博客解释为什么，Labs
        让你马上试一下。这里没有万能聊天框，只有边界清楚、证据可见、可以复现的小工具。
      </p>
      <div class="hero-actions">
        <a class="button button--primary" href="#hello-lab">体验 Hello Lab</a>
        <a
          class="button button--secondary"
          href="https://blog.margrop.net/start-here/"
        >
          阅读知识地图
        </a>
      </div>
      <dl class="hero-principles">
        <div><dt>01</dt><dd>确定性内核</dd></div>
        <div><dt>02</dt><dd>敏感数据本地优先</dd></div>
        <div><dt>03</dt><dd>AI 随时可降级</dd></div>
      </dl>
    </div>
  </section>

  <section class="labs-section" aria-labelledby="labs-heading">
    <div class="section-heading">
      <div>
        <p class="section-kicker">FIRST EXPERIMENTS</p>
        <h2 id="labs-heading">首批实验</h2>
      </div>
      <p>
        每个实验都必须提供无需登录、无需真实数据、无需消耗 AI 额度的样例模式。
      </p>
    </div>

    <div class="lab-grid">
      {
        labs.map((lab, index) => (
          <article
            class={`lab-card lab-card--${accents[index % accents.length]}`}
            data-lab-id={lab.id}
          >
            <div class="lab-card-meta">
              <span>{String(index + 1).padStart(2, "0")}</span>
              <span class="status">
                {strategicStatusLabels[lab.id] ?? statusLabels[lab.status]}
              </span>
            </div>
            <h3>{lab.title}</h3>
            <p>{lab.summary}</p>
            <ul
              class="lab-card-tags"
              aria-label={`${lab.title} 数据与 AI 标签`}
            >
              <li>{privacyLabels[lab.input_privacy]}</li>
              <li>{aiModeLabels[lab.ai_mode]}</li>
              <li>含合成样例</li>
            </ul>
            <div class="lab-card-links">
              {["alpha", "beta", "stable"].includes(lab.status) ? (
                <a class="route route--live" href={lab.route}>
                  打开实验 · {lab.route}
                </a>
              ) : (
                <code class="route">{lab.route}</code>
              )}
              {lab.related_articles.length > 0 ? (
                <ul aria-label={`${lab.title} 相关文章`}>
                  {lab.related_articles.map((article, articleIndex) => (
                    <li>
                      <a href={article}>阅读相关文章 {articleIndex + 1}</a>
                    </li>
                  ))}
                </ul>
              ) : (
                <span class="related-empty">相关文章待补充</span>
              )}
            </div>
          </article>
        ))
      }
    </div>
  </section>

  <div id="hello-lab" class="hello-lab-anchor">
    <TokenBudgetPreview client:visible={{ rootMargin: "240px" }} />
  </div>

  <section class="contract-section" aria-labelledby="contract-heading">
    <p class="section-kicker">PUBLIC CONTRACT</p>
    <h2 id="contract-heading">你始终知道数据去了哪里</h2>
    <div class="contract-grid">
      <article>
        <span>LOCAL</span>
        <h3>浏览器先处理</h3>
        <p>解析、计算和脱敏尽可能留在设备上，原始敏感文本默认不上传。</p>
      </article>
      <article>
        <span>MINIMAL</span>
        <h3>AI 只看必要摘要</h3>
        <p>需要模型时，只发送版本化、已脱敏、完成当前任务所需的最小结构。</p>
      </article>
      <article>
        <span>FALLBACK</span>
        <h3>没有 AI 仍然能用</h3>
        <p>额度耗尽、网络超时或返回无效时，确定性结果和合成样例继续工作。</p>
      </article>
    </div>
  </section>
</BaseLayout>
