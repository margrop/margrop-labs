---
import SmartRmaWorkbench, {
  type SmartRmaSample,
} from "../../components/SmartRmaWorkbench";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { loadLabManifests } from "../../lib/lab-manifests";
import { loadSmartRmaFixtureCorpus } from "../../lib/smart-rma-fixtures";

const labs = await loadLabManifests();
const lab = labs.find((candidate) => candidate.id === "smart-rma");

if (!lab) {
  throw new Error("SMART / RMA manifest is required for its public page.");
}

const corpus = await loadSmartRmaFixtureCorpus();
const sampleLabels: Record<string, string> = {
  "ata-healthy-7-4": "ATA SSD · 基础正常样例",
  "ata-warning-7-4": "ATA HDD · PASSED 但关键计数非零",
  "ata-vendor-extension-7-3": "ATA SSD · 未知厂商扩展",
  "nvme-healthy-7-4": "NVMe · 基础正常样例",
  "nvme-critical-7-4": "NVMe · Critical Warning 与介质错误",
  "sat-smart-unavailable-7-4": "USB-SAT · SMART 不可用",
  "ata-incomplete-6-5": "ATA · 旧版本与字段不完整",
};
const samples: SmartRmaSample[] = corpus.fixtures.map(({ id, raw }) => ({
  id,
  label: sampleLabels[id] ?? id,
  raw,
}));
---

<BaseLayout
  title="SMART / RMA 报告机｜Margrop Labs"
  description="在浏览器本地解析 smartctl 文本，识别 ATA、NVMe、关键属性、错误计数与缺失字段，不上传或保存原始输入。"
>
  <section class="lab-page">
    <header class="lab-page-hero">
      <div>
        <p class="eyebrow">SMART / RMA · ALPHA</p>
        <h1>先看懂 SMART，<br /><em>再谈健康结论。</em></h1>
        <p>
          粘贴 smartctl 文本或加载完全合成样例。浏览器只做确定性结构化解析，
          把工具报告、异常信号和未知项分开，不把 PASSED 包装成保修结论。
        </p>
      </div>
      <dl class="lab-page-contract">
        <div><dt>RAW INPUT</dt><dd>仅当前标签页</dd></div>
        <div><dt>NETWORK</dt><dd>不上传文本</dd></div>
        <div><dt>AI</dt><dd>本阶段不调用</dd></div>
        <div><dt>OUTPUT</dt><dd>仅解析证据</dd></div>
      </dl>
    </header>

    <SmartRmaWorkbench
      samples={samples}
      sourceUrl="https://github.com/margrop/margrop-labs/tree/main/labs/smart-rma"
      client:visible={{ rootMargin: "200px" }}
    />
  </section>
</BaseLayout>
