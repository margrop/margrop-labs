---
import TokenForgeWorkbench from "../../components/TokenForgeWorkbench";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { loadLabManifests } from "../../lib/lab-manifests";

const labs = await loadLabManifests();
const lab = labs.find((candidate) => candidate.id === "token-forge");

if (!lab) {
  throw new Error("Token Forge manifest is required for its public page.");
}

const articleUrl = lab.related_articles[0];

if (!articleUrl) {
  throw new Error("Token Forge requires a related article.");
}

const description =
  "把闲置 Coding Token、可投入时间与技术目标转换成范围清楚、预算受限、可直接导出的任务计划。";
const structuredData = {
  "@context": "https://schema.org",
  "@type": "WebApplication",
  name: "Token 任务炼金炉",
  alternateName: "Token Task Forge",
  url: "https://lab.margrop.net/token-forge/",
  description,
  applicationCategory: "DeveloperApplication",
  operatingSystem: "Any",
  browserRequirements: "Requires a modern browser",
  inLanguage: "zh-CN",
  isAccessibleForFree: true,
  featureList: [
    "无需登录的确定性任务模板",
    "可选的受限 AI 增强",
    "公开 GitHub 仓库只读摘要",
    "Markdown、GitHub Issue 与 Coding Agent 执行包导出",
  ],
  offers: {
    "@type": "Offer",
    price: "0",
    priceCurrency: "CNY",
  },
  creator: {
    "@type": "Person",
    name: "Margrop",
    url: "https://blog.margrop.net/",
  },
};
---

<BaseLayout
  title="Token 任务炼金炉｜Margrop Labs"
  {description}
  socialTitle="Token 任务炼金炉｜把闲置 Token 锻造成可验收任务"
  socialImagePath="/social/token-forge.png"
  socialImageAlt="Token 任务炼金炉：把闲置 Token 锻造成可以验收的任务"
  {structuredData}
>
  <section class="lab-page">
    <header class="lab-page-hero">
      <div>
        <p class="eyebrow">TOKEN FORGE · ALPHA</p>
        <h1>把闲置 Token，锻造成<br /><em>可以验收</em>的任务。</h1>
        <p>
          输入剩余额度、到期时间和一个可公开的目标；也可以附上公开 GitHub 仓库。
          你可以只用确定性模板，也可以显式请求受限 AI 增强；任一失败仍保留模板。
          首次体验可从 6K、24K、40K
          三档样例一键开始；生成后可在当前标签页编辑和锁定， 并导出分阶段 Coding
          Agent 执行包。
        </p>
      </div>
      <dl class="lab-page-contract">
        <div><dt>LOGIN</dt><dd>无需登录</dd></div>
        <div><dt>REPOSITORY</dt><dd>可选 · 公开只读</dd></div>
        <div><dt>AI</dt><dd>可选 · 服务端受限</dd></div>
        <div><dt>STORAGE</dt><dd>不保存输入</dd></div>
      </dl>
    </header>

    <TokenForgeWorkbench
      articleUrl={articleUrl}
      sourceUrl="https://github.com/margrop/margrop-labs/tree/main/labs/token-forge"
      client:visible={{ rootMargin: "200px" }}
    />
  </section>
</BaseLayout>
