{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:margrop-labs:incident-detective:scoring-rules:v1",
  "title": "Incident Detective Internal Scoring Rules v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "scenario_id", "dimensions"],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "scenario_id": {
      "$ref": "#/$defs/id"
    },
    "dimensions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "$ref": "#/$defs/dimension"
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "maxLength": 80
    },
    "label": {
      "type": "string",
      "minLength": 2,
      "maxLength": 80,
      "pattern": "\\S"
    },
    "message": {
      "type": "string",
      "minLength": 5,
      "maxLength": 300,
      "pattern": "\\S"
    },
    "positivePoints": {
      "type": "integer",
      "minimum": 1,
      "maximum": 20
    },
    "negativePoints": {
      "type": "integer",
      "minimum": -20,
      "maximum": -1
    },
    "evidenceIds": {
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/id"
      }
    },
    "serviceIds": {
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/id"
      }
    },
    "evidenceSelectedRule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "points",
        "evidence_id",
        "met_message",
        "missed_message"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "kind": {
          "const": "evidence_selected"
        },
        "points": {
          "$ref": "#/$defs/positivePoints"
        },
        "evidence_id": {
          "$ref": "#/$defs/id"
        },
        "met_message": {
          "$ref": "#/$defs/message"
        },
        "missed_message": {
          "$ref": "#/$defs/message"
        }
      }
    },
    "evidenceAnySelectedRule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "points",
        "evidence_ids",
        "met_message",
        "missed_message"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "kind": {
          "const": "evidence_any_selected"
        },
        "points": {
          "$ref": "#/$defs/positivePoints"
        },
        "evidence_ids": {
          "$ref": "#/$defs/evidenceIds"
        },
        "met_message": {
          "$ref": "#/$defs/message"
        },
        "missed_message": {
          "$ref": "#/$defs/message"
        }
      }
    },
    "evidenceSupportingRule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "points",
        "evidence_id",
        "met_message",
        "missed_message"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "kind": {
          "const": "evidence_supporting"
        },
        "points": {
          "$ref": "#/$defs/positivePoints"
        },
        "evidence_id": {
          "$ref": "#/$defs/id"
        },
        "met_message": {
          "$ref": "#/$defs/message"
        },
        "missed_message": {
          "$ref": "#/$defs/message"
        }
      }
    },
    "evidenceAnyContradictingRule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "points",
        "evidence_ids",
        "met_message",
        "missed_message"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "kind": {
          "const": "evidence_any_contradicting"
        },
        "points": {
          "$ref": "#/$defs/positivePoints"
        },
        "evidence_ids": {
          "$ref": "#/$defs/evidenceIds"
        },
        "met_message": {
          "$ref": "#/$defs/message"
        },
        "missed_message": {
          "$ref": "#/$defs/message"
        }
      }
    },
    "evidenceBeforeRule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "points",
        "before_evidence_id",
        "after_evidence_id",
        "met_message",
        "missed_message"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "kind": {
          "const": "evidence_before"
        },
        "points": {
          "$ref": "#/$defs/positivePoints"
        },
        "before_evidence_id": {
          "$ref": "#/$defs/id"
        },
        "after_evidence_id": {
          "$ref": "#/$defs/id"
        },
        "met_message": {
          "$ref": "#/$defs/message"
        },
        "missed_message": {
          "$ref": "#/$defs/message"
        }
      }
    },
    "serviceSuspectedRule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "points",
        "service_id",
        "met_message",
        "missed_message"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "kind": {
          "const": "service_suspected"
        },
        "points": {
          "$ref": "#/$defs/positivePoints"
        },
        "service_id": {
          "$ref": "#/$defs/id"
        },
        "met_message": {
          "$ref": "#/$defs/message"
        },
        "missed_message": {
          "$ref": "#/$defs/message"
        }
      }
    },
    "suspectedServicesWithinRule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "points",
        "service_ids",
        "met_message",
        "missed_message"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "kind": {
          "const": "suspected_services_within"
        },
        "points": {
          "$ref": "#/$defs/positivePoints"
        },
        "service_ids": {
          "$ref": "#/$defs/serviceIds"
        },
        "met_message": {
          "$ref": "#/$defs/message"
        },
        "missed_message": {
          "$ref": "#/$defs/message"
        }
      }
    },
    "safetySelectedRule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "points",
        "action",
        "met_message",
        "missed_message"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "kind": {
          "const": "safety_selected"
        },
        "points": {
          "$ref": "#/$defs/positivePoints"
        },
        "action": {
          "enum": [
            "read_only_first",
            "preserve_evidence",
            "least_privilege",
            "request_approval"
          ]
        },
        "met_message": {
          "$ref": "#/$defs/message"
        },
        "missed_message": {
          "$ref": "#/$defs/message"
        }
      }
    },
    "unsafeSelectedRule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "points",
        "action",
        "triggered_message",
        "avoided_message"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "kind": {
          "const": "unsafe_selected"
        },
        "points": {
          "$ref": "#/$defs/negativePoints"
        },
        "action": {
          "enum": ["production_write", "restart_service", "delete_data"]
        },
        "triggered_message": {
          "$ref": "#/$defs/message"
        },
        "avoided_message": {
          "$ref": "#/$defs/message"
        }
      }
    },
    "rule": {
      "oneOf": [
        {
          "$ref": "#/$defs/evidenceSelectedRule"
        },
        {
          "$ref": "#/$defs/evidenceAnySelectedRule"
        },
        {
          "$ref": "#/$defs/evidenceSupportingRule"
        },
        {
          "$ref": "#/$defs/evidenceAnyContradictingRule"
        },
        {
          "$ref": "#/$defs/evidenceBeforeRule"
        },
        {
          "$ref": "#/$defs/serviceSuspectedRule"
        },
        {
          "$ref": "#/$defs/suspectedServicesWithinRule"
        },
        {
          "$ref": "#/$defs/safetySelectedRule"
        },
        {
          "$ref": "#/$defs/unsafeSelectedRule"
        }
      ]
    },
    "dimension": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "max_points", "rules"],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "label": {
          "$ref": "#/$defs/label"
        },
        "max_points": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "rules": {
          "type": "array",
          "minItems": 1,
          "maxItems": 30,
          "items": {
            "$ref": "#/$defs/rule"
          }
        }
      }
    }
  }
}
