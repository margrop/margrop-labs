{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lab.margrop.net/schemas/incident-detective-share-card-v1.schema.json",
  "title": "Incident Detective Share Card v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "lab_id",
    "scenario_id",
    "total_score",
    "max_score",
    "band",
    "dimensions",
    "privacy"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "lab_id": {
      "const": "incident-detective"
    },
    "scenario_id": {
      "$ref": "#/$defs/id"
    },
    "total_score": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100
    },
    "max_score": {
      "const": 100
    },
    "band": {
      "enum": ["needs-evidence", "developing", "evidence-led", "excellent"]
    },
    "dimensions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "$ref": "#/$defs/dimension"
      }
    },
    "privacy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "synthetic_score_only",
        "contains_attempt_text",
        "contains_evidence_payload",
        "contains_answer"
      ],
      "properties": {
        "synthetic_score_only": {
          "const": true
        },
        "contains_attempt_text": {
          "const": false
        },
        "contains_evidence_payload": {
          "const": false
        },
        "contains_answer": {
          "const": false
        }
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "maxLength": 80
    },
    "label": {
      "type": "string",
      "minLength": 2,
      "maxLength": 80,
      "pattern": "\\S"
    },
    "dimension": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "score", "max_score"],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "label": {
          "$ref": "#/$defs/label"
        },
        "score": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "max_score": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        }
      }
    }
  }
}
