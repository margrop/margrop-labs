{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lab.margrop.net/schemas/token-forge-input-v1.schema.json",
  "title": "Token Forge Input v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "token_budget",
    "expires_in_days",
    "available_hours",
    "tech_stack",
    "goal"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "token_budget": {
      "type": "integer",
      "minimum": 2000,
      "maximum": 60000
    },
    "expires_in_days": {
      "type": "integer",
      "minimum": 1,
      "maximum": 30
    },
    "available_hours": {
      "type": "number",
      "minimum": 1,
      "maximum": 80,
      "multipleOf": 0.5
    },
    "tech_stack": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 40,
        "pattern": "\\S"
      }
    },
    "goal": {
      "type": "string",
      "minLength": 10,
      "maxLength": 500,
      "pattern": "\\S"
    },
    "repository_url": {
      "type": "string",
      "format": "uri",
      "maxLength": 200,
      "pattern": "^https://github\\.com/[A-Za-z0-9](?:[A-Za-z0-9_.-]{0,38})/[A-Za-z0-9_.-]+/?$"
    }
  }
}
