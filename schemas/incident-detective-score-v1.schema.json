{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lab.margrop.net/schemas/incident-detective-score-v1.schema.json",
  "title": "Incident Detective Score v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "scenario_id",
    "total_score",
    "max_score",
    "band",
    "dimensions",
    "strengths",
    "improvements"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "scenario_id": {
      "$ref": "#/$defs/id"
    },
    "total_score": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100
    },
    "max_score": {
      "const": 100
    },
    "band": {
      "enum": ["needs-evidence", "developing", "evidence-led", "excellent"]
    },
    "dimensions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "$ref": "#/$defs/dimension"
      }
    },
    "strengths": {
      "$ref": "#/$defs/messages"
    },
    "improvements": {
      "$ref": "#/$defs/messages"
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "maxLength": 80
    },
    "label": {
      "type": "string",
      "minLength": 2,
      "maxLength": 80,
      "pattern": "\\S"
    },
    "message": {
      "type": "string",
      "minLength": 5,
      "maxLength": 300,
      "pattern": "\\S"
    },
    "messages": {
      "type": "array",
      "maxItems": 30,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/message"
      }
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rule_id", "status", "points_awarded", "message"],
      "properties": {
        "rule_id": {
          "$ref": "#/$defs/id"
        },
        "status": {
          "enum": ["met", "missed", "penalty", "avoided"]
        },
        "points_awarded": {
          "type": "integer",
          "minimum": -20,
          "maximum": 20
        },
        "message": {
          "$ref": "#/$defs/message"
        }
      }
    },
    "dimension": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "score", "max_score", "findings"],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "label": {
          "$ref": "#/$defs/label"
        },
        "score": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "max_score": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "findings": {
          "type": "array",
          "minItems": 1,
          "maxItems": 30,
          "items": {
            "$ref": "#/$defs/finding"
          }
        }
      }
    }
  }
}
