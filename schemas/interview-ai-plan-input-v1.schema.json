{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lab.margrop.net/schemas/interview-ai-plan-input-v1.schema.json",
  "title": "Interview Workbench AI Plan Input v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "boundary",
    "match",
    "mode",
    "duration_minutes",
    "early_gate_requirement_ids",
    "safeguards"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "boundary": {
      "$ref": "https://lab.margrop.net/schemas/interview-boundary-projection-v1.schema.json"
    },
    "match": {
      "$ref": "https://lab.margrop.net/schemas/interview-match-v1.schema.json"
    },
    "mode": { "enum": ["interviewer", "candidate"] },
    "duration_minutes": { "enum": [30, 45, 60] },
    "early_gate_requirement_ids": {
      "type": "array",
      "maxItems": 30,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/id" }
    },
    "safeguards": { "$ref": "#/$defs/safeguards" }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "maxLength": 80
    },
    "safeguards": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "unknown_is_not_negative",
        "protected_attribute_inference",
        "automatic_decision"
      ],
      "properties": {
        "unknown_is_not_negative": { "const": true },
        "protected_attribute_inference": { "const": false },
        "automatic_decision": { "const": false }
      }
    }
  }
}
