{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lab.margrop.net/schemas/ai-gateway-request-v1.schema.json",
  "title": "Margrop Labs AI Gateway Request v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "request_id", "lab_id", "operation", "input"],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "request_id": {
      "type": "string",
      "format": "uuid",
      "maxLength": 36
    },
    "lab_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "operation": {
      "type": "string",
      "minLength": 3,
      "maxLength": 96,
      "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$"
    },
    "input": {
      "type": "object",
      "maxProperties": 64
    }
  }
}
