{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lab.margrop.net/schemas/interview-requirement-v1.schema.json",
  "title": "Interview Workbench Requirement v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "sensitivity",
    "requirement_id",
    "category",
    "priority",
    "statement",
    "evidence_signals"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "sensitivity": { "const": "sensitive" },
    "requirement_id": { "$ref": "#/$defs/id" },
    "category": {
      "enum": ["must_have", "technical", "domain", "scope", "collaboration"]
    },
    "priority": { "enum": ["must", "should", "nice"] },
    "statement": { "$ref": "#/$defs/paragraph" },
    "evidence_signals": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/shortText" }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "maxLength": 80
    },
    "shortText": {
      "type": "string",
      "minLength": 1,
      "maxLength": 240,
      "pattern": "\\S"
    },
    "paragraph": {
      "type": "string",
      "minLength": 10,
      "maxLength": 800,
      "pattern": "\\S"
    }
  }
}
