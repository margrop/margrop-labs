{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lab.margrop.net/schemas/interview-jd-v1.schema.json",
  "title": "Interview Workbench Job Description v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "sensitivity",
    "jd_id",
    "role_title",
    "level",
    "responsibilities",
    "requirements"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "sensitivity": { "const": "sensitive" },
    "jd_id": { "$ref": "#/$defs/id" },
    "role_title": { "$ref": "#/$defs/shortText" },
    "level": { "enum": ["junior", "mid", "senior", "lead", "unknown"] },
    "responsibilities": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": { "$ref": "#/$defs/paragraph" }
    },
    "requirements": {
      "type": "array",
      "minItems": 1,
      "maxItems": 30,
      "items": { "$ref": "#/$defs/requirement" }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "maxLength": 80
    },
    "shortText": {
      "type": "string",
      "minLength": 1,
      "maxLength": 240,
      "pattern": "\\S"
    },
    "paragraph": {
      "type": "string",
      "minLength": 10,
      "maxLength": 800,
      "pattern": "\\S"
    },
    "requirement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requirement_id",
        "category",
        "priority",
        "statement",
        "evidence_signals"
      ],
      "properties": {
        "requirement_id": { "$ref": "#/$defs/id" },
        "category": {
          "enum": ["must_have", "technical", "domain", "scope", "collaboration"]
        },
        "priority": { "enum": ["must", "should", "nice"] },
        "statement": { "$ref": "#/$defs/paragraph" },
        "evidence_signals": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/shortText" }
        }
      }
    }
  }
}
