{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lab.margrop.net/schemas/token-forge-blog-cta-v1.schema.json",
  "title": "Token Forge blog CTA v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "lab_id",
    "title",
    "summary",
    "compact_note",
    "proof_points",
    "privacy_note",
    "primary_action",
    "source_action",
    "offline_action"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "lab_id": {
      "const": "token-forge"
    },
    "title": {
      "$ref": "#/$defs/copy"
    },
    "summary": {
      "$ref": "#/$defs/copy"
    },
    "compact_note": {
      "$ref": "#/$defs/copy"
    },
    "proof_points": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/copy"
      }
    },
    "privacy_note": {
      "$ref": "#/$defs/copy"
    },
    "primary_action": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "url"],
      "properties": {
        "label": {
          "$ref": "#/$defs/label"
        },
        "url": {
          "const": "https://lab.margrop.net/token-forge/"
        }
      }
    },
    "source_action": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "url"],
      "properties": {
        "label": {
          "$ref": "#/$defs/label"
        },
        "url": {
          "const": "https://github.com/margrop/margrop-labs/tree/main/labs/token-forge"
        }
      }
    },
    "offline_action": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "url"],
      "properties": {
        "label": {
          "$ref": "#/$defs/label"
        },
        "url": {
          "const": "https://github.com/margrop/margrop-labs/blob/main/docs/token-forge-template-mode.md"
        }
      }
    }
  },
  "$defs": {
    "copy": {
      "type": "string",
      "minLength": 4,
      "maxLength": 160,
      "pattern": "^[^\\r\\n<>\\[\\]]+$"
    },
    "label": {
      "type": "string",
      "minLength": 2,
      "maxLength": 30,
      "pattern": "^[^\\r\\n<>\\[\\]()]+$"
    }
  }
}
