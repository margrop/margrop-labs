{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lab.margrop.net/schemas/incident-detective-ai-explanation-v1.schema.json",
  "title": "Incident Detective AI Explanation v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "scenario_id",
    "total_score",
    "headline",
    "strengths",
    "gaps",
    "safe_next_steps",
    "unknowns",
    "disclaimer"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "scenario_id": { "$ref": "#/$defs/id" },
    "total_score": { "type": "integer", "minimum": 0, "maximum": 100 },
    "headline": { "$ref": "#/$defs/text" },
    "strengths": {
      "type": "array",
      "maxItems": 8,
      "items": { "$ref": "#/$defs/finding_explanation" }
    },
    "gaps": {
      "type": "array",
      "maxItems": 12,
      "items": { "$ref": "#/$defs/gap" }
    },
    "safe_next_steps": {
      "type": "array",
      "minItems": 1,
      "maxItems": 6,
      "items": { "$ref": "#/$defs/next_step" }
    },
    "unknowns": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/text" }
    },
    "disclaimer": {
      "const": "AI 解释不改变确定性评分、案例事实或未知项。"
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "maxLength": 80
    },
    "text": {
      "type": "string",
      "minLength": 5,
      "maxLength": 300,
      "pattern": "\\S"
    },
    "ids": {
      "type": "array",
      "maxItems": 8,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/id" }
    },
    "finding_explanation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["finding_rule_id", "explanation"],
      "properties": {
        "finding_rule_id": { "$ref": "#/$defs/id" },
        "explanation": { "$ref": "#/$defs/text" }
      }
    },
    "gap": {
      "type": "object",
      "additionalProperties": false,
      "required": ["finding_rule_id", "explanation", "evidence_ids"],
      "properties": {
        "finding_rule_id": { "$ref": "#/$defs/id" },
        "explanation": { "$ref": "#/$defs/text" },
        "evidence_ids": { "$ref": "#/$defs/ids" }
      }
    },
    "next_step": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "rationale", "evidence_ids", "safety"],
      "properties": {
        "title": { "$ref": "#/$defs/text" },
        "rationale": { "$ref": "#/$defs/text" },
        "evidence_ids": { "$ref": "#/$defs/ids" },
        "safety": { "enum": ["read-only", "approval-required"] }
      }
    }
  }
}
